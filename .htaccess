Options -Indexes
ServerSignature Off

# Block sensitive extensions & config/lock files
<FilesMatch "\.(sql|log|md|ini|sh|bak|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force preferred host (non-www) + HTTPS on live domains (skips localhost / 127.0.0.1)
    # To prefer www instead, replace with: RewriteCond %{HTTP_HOST} !^www\. [NC] -> https://www.%{HTTP_HOST}%{REQUEST_URI}
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Protect internal directories
    RewriteRule ^(config|includes|database|pages|storage)/ - [F,L]

    # Route all non-file requests through index.php cleanly (no hardcoded RewriteBase)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

    # Strict anti-framing & strict CSP (zero inline scripts allowed).
    # Exception strictly for localhost/::1 Admin /debug/overflow.html QA iframe verification.
    <If "%{REMOTE_ADDR} == '127.0.0.1' || %{REMOTE_ADDR} == '::1'">
        SetEnvIf Referer "/debug/overflow\.html" ALLOW_LOCAL_QA=1
    </If>
    Header always set X-Frame-Options "DENY" env=!ALLOW_LOCAL_QA
    Header always set X-Frame-Options "SAMEORIGIN" env=ALLOW_LOCAL_QA
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" env=!ALLOW_LOCAL_QA
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'" env=ALLOW_LOCAL_QA

    # Additional hardening for /admin routes (covers direct and internal rewrite)
    SetEnvIf Request_URI "/admin" IS_ADMIN_ROUTE=1
    Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=IS_ADMIN_ROUTE
    Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=REDIRECT_IS_ADMIN_ROUTE
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=IS_ADMIN_ROUTE
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=REDIRECT_IS_ADMIN_ROUTE
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/manifest+json image/svg+xml application/xml
</IfModule>

# Enable ETag + Last-Modified for static assets
FileETag MTime Size

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/manifest+json "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<FilesMatch "\.(css|js|svg|png|jpe?g|webp|ico|woff2|webmanifest)$">
    <IfModule mod_headers.c>
        Header append Cache-Control "public"
    </IfModule>
</FilesMatch>
